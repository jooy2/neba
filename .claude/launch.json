{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "docs",
        "run",
        "dev",
        "--",
        "--port",
        "5273",
        "--strictPort"
      ],
      "port": 5273,
      "autoPort": false
    },
    {
      "name": "flutter-gallery",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5290",
        "--directory",
        "docs/public"
      ],
      "port": 5290,
      "autoPort": false,
      "url": "http://localhost:5290"
    }
  ]
}
