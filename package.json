{
  "name": "neba",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "types": "dist/index.d.ts",
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "homepage": "https://neba.cdget.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/neba"
  },
  "bugs": {
    "url": "https://github.com/jooy2/neba/issues"
  },
  "scripts": {
    "build": "npm run format:fix && tsc --project tsconfig.prod.json && npm run minify",
    "lint": "eslint . --ext .js,.ts .",
    "lint:fix": "eslint . --ext .js,.ts --fix .",
    "minify": "terser-glob 'dist/**/*.js' --config-file terser.config.json",
    "prepare": "npm run build",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "docs:dev": "npm run build && vitepress dev docs",
    "docs:build": "npm run build && vitepress build docs",
    "docs:serve": "npm run build && npm run docs:build && vitepress serve docs",
    "demo:dev": "vite dev",
    "demo:build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "module": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "typesVersions": {
    "*": {
      "index.d.ts": [
        "dist/index.d.ts"
      ]
    }
  },
  "keywords": [
    "vitepress"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.23.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "prettier": "^3.7.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "terser-glob": "^1.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vitepress-i18n": "^1.3.4",
    "vitepress-sidebar": "^1.33.1"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0"
  }
}
