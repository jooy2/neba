{
  "name": "neba",
  "version": "1.16.2",
  "description": "A comprehensive React UI component library — buttons, fields, menus, dialogs, tables and much more — accessible and themeable, sharing one prop vocabulary and a translucent acrylic design language. ESM only, types included, dark mode built in.",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "author": "CDGet (https://cdget.com)",
  "license": "MIT",
  "homepage": "https://neba.cdget.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/neba"
  },
  "bugs": {
    "url": "https://github.com/jooy2/neba/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run format:fix && tsc --project tsconfig.prod.json && node scripts/annotate-pure.mjs && npm run minify && node scripts/build-styles.mjs && node scripts/build-catalog.mjs",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "minify": "node scripts/minify.mjs",
    "size": "node scripts/measure-bundle.mjs",
    "size:update": "node scripts/measure-bundle.mjs --update",
    "compat": "node scripts/check-browsers.mjs",
    "prepare": "npm run build",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "docs:changelog": "node scripts/copy-changelog.mjs",
    "docs:dev": "npm run docs:changelog && npm run docs:catalog && vitepress dev docs",
    "docs:build": "npm run docs:changelog && npm run docs:catalog && node --max-old-space-size=8192 ./node_modules/vitepress/bin/vitepress.js build docs",
    "docs:serve": "npm run docs:build && vitepress serve docs",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.prod.json --noEmit && tsc --project test/tsconfig.json && tsc --project docs/tsconfig.json",
    "docs:catalog": "node scripts/build-catalog.mjs --docs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "module": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "module": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "module": "./dist/locales/index.js",
      "default": "./dist/locales/index.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "module": "./dist/locales/*.js",
      "default": "./dist/locales/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json",
    "./a2ui": {
      "types": "./dist/a2ui/index.d.ts",
      "module": "./dist/a2ui/index.js",
      "default": "./dist/a2ui/index.js"
    },
    "./a2ui/catalog.json": "./dist/a2ui/catalog.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "module": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "index.d.ts": [
        "dist/index.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ],
      "locales": [
        "dist/locales/index.d.ts"
      ],
      "locales/*": [
        "dist/locales/*.d.ts"
      ],
      "hooks": [
        "dist/hooks/index.d.ts"
      ],
      "a2ui": [
        "dist/a2ui/index.d.ts"
      ],
      "*": [
        "dist/components/*/index.d.ts"
      ]
    }
  },
  "keywords": [
    "neba",
    "react",
    "reactjs",
    "react-components",
    "react-ui",
    "ui",
    "ui-kit",
    "ui-library",
    "ui-components",
    "component-library",
    "components",
    "design-system",
    "design-language",
    "frontend",
    "web",
    "typescript",
    "tsx",
    "esm",
    "accessible",
    "accessibility",
    "a11y",
    "aria",
    "wai-aria",
    "dark-mode",
    "theming",
    "responsive",
    "acrylic",
    "glass",
    "glassmorphism",
    "button",
    "dialog",
    "modal",
    "menu",
    "select",
    "combobox",
    "table",
    "tabs",
    "toast",
    "tooltip",
    "form"
  ],
  "devDependencies": {
    "@a2ui/react": "^0.11.1",
    "@a2ui/web_core": "^0.11.0",
    "@eslint/js": "^9.39.1",
    "@mdn/browser-compat-data": "^8.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitepress-i18n": "^1.4.0",
    "vitepress-sidebar": "^1.40.0",
    "vitest": "^5.0.2",
    "vitest-browser-react": "^2.3.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "highlight.js": "^11.12.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@a2ui/react": "^0.11.0",
    "@a2ui/web_core": "^0.11.0",
    "zod": "^3.25.76"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@a2ui/react": {
      "optional": true
    },
    "@a2ui/web_core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
